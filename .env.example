# Copie para .env.local em desenvolvimento. No Coolify, cadastre como variáveis
# de ambiente do app. Nunca commite valores reais.

# --- Banco (necessário desde o primeiro deploy) ---
DATABASE_URL=postgres://tempmail:senha@localhost:5432/tempmail
# Roda as migrations ao subir o servidor. Use "false" pra pular.
RUN_MIGRATIONS=true

# --- Caixas (opcionais; os valores abaixo já são os padrões) ---
MAIL_DOMAIN=tmp.mateussiil.com.br
MAX_ACTIVE_INBOXES_PER_MEMBER=20
INBOX_TTL_HOURS=24

# --- Limpeza periódica (opcional; os valores abaixo já são os padrões) ---
# Expira as Caixas de quem saiu da lista, apaga o conteúdo das vencidas e varre o R2.
RUN_EXPIRATION=true
EXPIRATION_INTERVAL_MINUTES=10

# --- Chaves de API (opcional; o valor abaixo já é o padrão) ---
# Pedidos por minuto por chave; passou, a API responde 429.
API_RATE_LIMIT_PER_MINUTE=60

# --- Recebimento de emails ---
# Cloudflare R2: onde fica o .eml de cada Mensagem.
R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tempmail
# Resend: chave com ACESSO TOTAL (chave só de envio é recusada ao buscar emails
# recebidos). Crie uma só pro tempmail.
RESEND_API_KEY=
# Signing Secret do webhook email.received (só existe depois de criar o webhook).
RESEND_WEBHOOK_SECRET=
# Opcionais (os valores abaixo já são os padrões):
MAX_MESSAGE_MB=10
# Com "true", registra o payload do webhook e a resposta do Resend no log. Só com
# emails de teste, e desligue depois.
WEBHOOK_DEBUG_LOG=false
# Só para testes: aponta a API do Resend para um servidor local.
# RESEND_API_URL=https://api.resend.com

# --- Login com GitHub via Better Auth (ticket de login) ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://tempmail.mateussiil.com.br
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usernames do GitHub autorizados, separados por vírgula.
ALLOWED_GITHUB_USERS=mateussiil

# --- Conector do claude.ai via OAuth (opcionais; os valores abaixo já são os padrões) ---
# Hosts dos Client ID Metadata Documents aceitos (quem pode ser cliente OAuth).
OAUTH_CLIENT_HOSTS=claude.ai
# Onde o MCP busca as chaves públicas dos tokens. Padrão: o próprio servidor por dentro.
# OAUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
