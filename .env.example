# Copie para .env.local em desenvolvimento. No Coolify, cadastre como variáveis
# de ambiente do app. Nunca commite valores reais.

# --- Banco (necessário desde o primeiro deploy) ---
DATABASE_URL=postgres://tempmail:senha@localhost:5432/tempmail
# Roda as migrations ao subir o servidor. Use "false" pra pular.
RUN_MIGRATIONS=true

# --- Caixas (opcionais; os valores abaixo já são os padrões) ---
MAIL_DOMAIN=tmp.mateussiil.com.br
MAX_ACTIVE_INBOXES_PER_MEMBER=20
INBOX_TTL_HOURS=24

# --- Cloudflare R2 (ticket de recebimento) ---
R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tempmail

# --- Resend (ticket de recebimento) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Login com GitHub via Better Auth (ticket de login) ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://tempmail.mateussiil.com.br
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usernames do GitHub autorizados, separados por vírgula.
ALLOWED_GITHUB_USERS=mateussiil
